.vercel
# Generated by vercel.json's buildCommand (copy of the frontend's Vite
# build output) — not a source directory.
/public

# Generated by vercel.json's buildCommand (server-build.mjs bundles
# server.ts into these via esbuild) — not source files. server.ts itself
# stays tracked; these are its build output plus pino's worker-thread
# chunks, all written to the repo root only during the Vercel build.
/server.js
/server.js.map
/pino-worker.js
/pino-worker.js.map
/pino-file.js
/pino-file.js.map
/pino-pretty.js
/pino-pretty.js.map
/thread-stream-worker.js
/thread-stream-worker.js.map

